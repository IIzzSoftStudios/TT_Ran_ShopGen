*.py[cod]
*$py.class

.venv/
venv/
env/

*.sqlite
*.sqlite3
*.db
flask_session/

*.log
logs/
app/services/logs/

.vscode/
.idea/
.DS_Store
Thumbs.db

.pytest_cache/
.coverage
htmlcov/

.git/
.gitignore

docker-compose.override.yml
