# Copy to config.env and fill in real values. Do NOT commit config.env.
# In GCP, these come from Cloud Run / GCE service env + Secret Manager.

# ==============================================================================
# ECONO-FORGE RUNTIME ENVIRONMENT MATRIX
# ==============================================================================
# Roles Key:
# [Dev] — Local development
# [Web] — Google Cloud Run web revision (HTTP /healthz, /ready)
# [Mig] — Cloud Run schema migration episodic job (TRSG_CLOUD_RUN_MIGRATE=true)
# [Wrk] — GCE Celery worker (TRSG_ROLE=worker or CELERY_WORKER_RUNNING=1)
# ==============================================================================
# Cloud Build trigger substitutions (_REGION, _SERVICE, _VPC_CONNECTOR, etc.)
# are documented in deploy/README.md — not application runtime keys.
# ==============================================================================

# --- ROLE IDENTIFICATION ---
# [Dev][Web][Mig][Wrk] Process persona; worker hosts use worker (see deploy/systemd/).
# TRSG_ROLE=web

# Flask
# [Dev][Web][Mig]
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change_me_in_real_env

# Database
# [Dev][Web][Mig][Wrk]
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://USER:PASSWORD@localhost:5432/DBNAME
# GCP: Cloud Run uses a different shape (Unix socket) — see deploy/README.md
# section "`SQLALCHEMY_DATABASE_URI`: one env locally vs two values in prod".
# The GCE Celery worker typically uses 127.0.0.1:5432 via Cloud SQL Auth Proxy
# in /etc/trsg/worker.env, not the same string as Cloud Run.
# [Dev][Web][Mig][Wrk] Set true only when actively debugging SQL; large log volume.
SQLALCHEMY_ECHO=false

# Sessions / locks / Celery broker (one canonical Redis URL).
# [Dev][Web][Mig][Wrk]
REDIS_URL=redis://localhost:6379/0
# [Dev][Web][Wrk] Optional split if broker and result backend live in different Redis DBs.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# [Dev][Web] Production (FLASK_ENV=production): defaults to true if unset — keep true behind HTTPS.
# Development: app defaults to false if unset so http:// login/CSRF work.
SESSION_COOKIE_SECURE=false

# Logging
# [Dev][Web][Mig][Wrk]
LOG_LEVEL=INFO

# Mail (transactional provider in prod, e.g. SendGrid / Mailgun / Brevo).
# [Dev][Web]
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app_password_here
MAIL_DEFAULT_SENDER=you@example.com

# Investor deck request notifications (email-only workflow; submissions are not stored).
# [Dev][Web]
INVESTOR_DECK_NOTIFY_EMAIL=iizzsoftstudios@gmail.com

# Creator partnership intake (email-only; submissions are not stored).
# [Dev][Web]
CREATOR_PARTNERSHIP_NOTIFY_EMAIL=iizzsoftstudios@gmail.com

# Application metadata
# [Dev][Web]
APP_NAME=Econo-Forge
BASE_URL=http://localhost:5000

# --- DEPLOYMENT KNOBS & ROADMAP TELEMETRY ---
# [Dev][Web] Registration gate (auth_handler.py). Code default: false.
# Production recommendation: set true to require a registration key.
# REQUIRE_REGISTRATION_KEY=false

# [Dev][Web][Wrk] World state dual-write / read paths (simulation_flags.py, world_state_reads.py).
# WORLD_STATE_ENABLED defaults true in code; set false to disable GMWorldState writes.
# WORLD_STATE_ENABLED=true
# [Dev][Web] Player routes read prices/stock from GMWorldState JSON only when true.
# READ_PRICES_FROM_WORLD_STATE=false

# [Dev][Web][Wrk] Simulation metrics ring buffer cap (sim_metrics.py). Code default: 256.
# METRICS_DURATIONS_CAP=256
# [Dev][Web] TTL for terminal simulation metrics keys in Redis. Code default: 86400.
# METRICS_TERMINAL_TTL_SECONDS=86400

# [Dev][Wrk] Extra tick invariants in simulation.py (dev/debug only).
# SIM_TICK_DEBUG_ASSERTS=false

# [Mig] Cloud Build one-shot migrate job: skips Redis session/limiter wiring in app factory.
# TRSG_CLOUD_RUN_MIGRATE=false

# Billing limits (local dev): allow more than one campaign before
# "Generate World" returns HTTP 402. Default in code is 1 if unset.
# [Dev]
# FREE_CAMPAIGN_LIMIT=5

# Public Demo (landing "Try Demo" → GET /demo).
# Runtime restores an immutable snapshot into a private throwaway campaign.
# Default file: app/data/demo_snapshots/demo_template_v1.json
# Override with an absolute or project-relative path:
# [Dev][Web]
# DEMO_SNAPSHOT_PATH=app/data/demo_snapshots/demo_template_v1.json
#
# Operator export source only (not read by /demo at runtime once a snapshot exists):
#   python scripts/export_demo_snapshot.py --campaign-id <id>
# [Dev]
# DEMO_TEMPLATE_CAMPAIGN_ID=

# Security
# [Dev][Web]
REQUIRE_EMAIL_VERIFICATION=False
REQUIRE_2FA=False

# Simulation worker tuning
# [Dev][Web][Wrk]
SIM_JOB_TTL_SECONDS=86400
# Per-campaign Redis lock TTL. Must exceed the worst-case period runtime
# (typically a 365-tick Year). The Celery task refreshes the lock during
# long batches, but the initial TTL is the safety floor if the refresh
# thread stalls. Default 7200s (2h) — tighten with metrics from
# alpha-metrics-queue once profiled.
SIMULATION_LOCK_TTL_SECONDS=7200
# Lock-refresh cadence (seconds). The task extends the lock at this interval
# while a batch is in flight. Should be << SIMULATION_LOCK_TTL_SECONDS.
SIMULATION_LOCK_REFRESH_SECONDS=60

# Schema bootstrap break-glass: when FLASK_ENV=production the runtime
# schema_compat bootstrap is skipped (migrations must run via
# scripts/init_schema.py or scripts/apply_sql_migrations.py before deploy).
# Setting RUN_BOOTSTRAP_IN_PROD=true re-enables the in-process bootstrap for
# explicit recovery only — leave unset in normal operation.
# [Dev][Web]
# RUN_BOOTSTRAP_IN_PROD=false

# Database connection pool. Defaults differ by role: web tier (Cloud Run)
# uses 5+5; Celery workers (TRSG_ROLE=worker) use 2+2 to leave headroom for
# the web tier under Cloud SQL `max_connections`. Tune per Cloud SQL tier:
#   total_conns >= web_max_instances * gunicorn_workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#                + worker_vms * CELERY_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# [Dev][Web][Wrk]
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# Celery worker tunables (read by deploy/systemd/trsg-worker.service):
# On native Windows dev, celery_app.py defaults worker_pool=solo (override with
# CELERY_WORKER_POOL=threads). Docker/Linux use prefork via the worker command.
# [Dev][Wrk]
# CELERY_WORKER_POOL=solo
# CELERY_CONCURRENCY=1
# CELERY_TIME_LIMIT=7200
# CELERY_SOFT_TIME_LIMIT=6900
# CELERY_MAX_TASKS_PER_CHILD=50

# Rate limiter storage. Falls back to LIMITER_STORAGE_URI, then REDIS_URL.
# Production must point at Redis (in-memory limiter is per-process and useless
# under multi-instance Cloud Run). Set explicitly when broker and limiter
# should live on different DBs/clusters (see redis-hot-path-split).
# [Dev][Web]
# LIMITER_STORAGE_URI=redis://localhost:6379/1

# --- FALLBACKS & TESTING HOOKS ---
# [Dev] Thread-isolated fallback when Redis is unavailable (app/__init__.py).
# Production default: false when FLASK_ENV=production; dev default: true if unset.
# SESSION_REDIS_FALLBACK=false
# [Dev] Pytest/CI: filesystem sessions instead of Redis (conftest.py, cloudbuild test step).
# TRSG_TEST_FILESYSTEM_SESSION=false
# [Wrk] Set by systemd worker unit; marks Celery worker process for pool defaults.
# CELERY_WORKER_RUNNING=false
