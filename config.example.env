# Copy to config.env and fill in real values. Do not commit config.env.
# Flask Secret Key (required)
SECRET_KEY=change_me_in_real_env

# Database Connection String
SQLALCHEMY_DATABASE_URI=postgresql://USER:PASSWORD@localhost/DBNAME

# Optional: Flask Environment
FLASK_ENV=development

# Email Configuration (e.g. Brevo/Mailtrap for testing)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app_password_here
MAIL_DEFAULT_SENDER=you@example.com

# Application Settings
APP_NAME=TT Shop Gen
BASE_URL=http://localhost:5000

# Security Settings
REQUIRE_EMAIL_VERIFICATION=False
REQUIRE_2FA=False
