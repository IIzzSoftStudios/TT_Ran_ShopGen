[Unit]
Description=TT Ran ShopGen Celery worker (econ-forge GCE worker host)
Documentation=file:///opt/trsg/README
After=network-online.target docker.service trsg-cloud-sql-proxy.service trsg-redis.service
Wants=network-online.target
Requires=docker.service

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

# Defaults for Celery CLI flags (systemd expands ${VAR} here; bash-style
# ${VAR:-default} is NOT supported — use Environment= below or override.conf).
Environment=CELERY_CONCURRENCY=1 CELERY_MAX_TASKS_PER_CHILD=50 CELERY_TIME_LIMIT=7200 CELERY_SOFT_TIME_LIMIT=6900

# Image pinning policy:
#   TRSG_IMAGE MUST be a digest (set in override.conf), e.g.
#   region-docker.pkg.dev/PROJECT/REPO/trsg-web@sha256:...
#   Cloud Build writes it to gs://$PROJECT-cloudbuild-artifacts/trsg-web/$SHA/image_digest.txt;
#   align worker with the same digest as Cloud Run.
#   `docker pull` is still issued so a freshly added VM warms its local
#     cache; with a digest, the pull is a no-op when already present.
ExecStartPre=-/usr/bin/docker rm -f trsg-worker
ExecStartPre=/usr/bin/docker pull ${TRSG_IMAGE}

# Concurrency / timeouts are env-tunable so Alpha can ramp from --concurrency=1
# upward (target ~10) without touching the service file:
#   CELERY_CONCURRENCY      Worker processes per VM (default 1 — start small,
#                           ramp while watching RAM and Cloud SQL connections).
#   CELERY_TIME_LIMIT       Hard kill (s). Default 7200 (2h) — a 365-tick Year
#                           must finish well under this; profile and tune.
#   CELERY_SOFT_TIME_LIMIT  Soft (raises SoftTimeLimitExceeded). Default 6900.
#   CELERY_MAX_TASKS_PER_CHILD  Process recycle threshold (default 50) bounds
#                           memory growth from long-lived workers.
# TRSG_ROLE=worker tags the connection pool sizing in app/__init__.py so a
# worker holding DB connections per task does not starve the Cloud Run web tier.
ExecStart=/usr/bin/docker run --rm --name trsg-worker \
  --network host \
  --env-file /etc/trsg/worker.env \
  --env TRSG_ROLE=worker \
  --env CELERY_WORKER_RUNNING=1 \
  ${TRSG_IMAGE} \
  celery -A celery_app.celery worker \
    --loglevel=info \
    --concurrency=${CELERY_CONCURRENCY} \
    --max-tasks-per-child=${CELERY_MAX_TASKS_PER_CHILD} \
    --time-limit=${CELERY_TIME_LIMIT} \
    --soft-time-limit=${CELERY_SOFT_TIME_LIMIT}
ExecStop=/usr/bin/docker stop -t 30 trsg-worker

# /etc/trsg/worker.env supplies REDIS_URL (typically redis://127.0.0.1:6379/0
# when Redis is local on the same VM), SQLALCHEMY_DATABASE_URI pointing at
# the Cloud SQL Auth Proxy on 127.0.0.1:5432, SECRET_KEY, FLASK_ENV, and
# the CELERY_* and DB_* tunables above. TRSG_IMAGE (a sha256 digest) is set
# in /etc/systemd/system/trsg-worker.service.d/override.conf so version bumps
# are a single `systemctl daemon-reload && systemctl restart trsg-worker` away.

[Install]
WantedBy=multi-user.target
